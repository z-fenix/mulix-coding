#!/usr/bin/env bash
# Close one inline task: check its evidence and refresh its brief before
# appending a sectioned completion record. In mulix, pass `mulix test receipt --task N`
# after the actual GREEN/CHECK has run. A failed check or refresh cannot close
# the task; the helper does not create a native execution receipt itself.
# Usage: task-done PLAN_PATH TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]
# Native plans require the exact current-receipt command; legacy plans keep
# the generic test-command interface.
set -euo pipefail

if [ $# -lt 5 ] || [ "$4" != "--" ]; then
  echo "usage: task-done PLAN_PATH TASK_NUMBER BASE -- TEST_COMMAND [ARGS...]" >&2
  exit 2
fi

plan=$1
n=$2
base=$3
shift 4
sdd="$(cd "$(dirname "$0")/../../subagent-driven-development/scripts" && pwd)"

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }

dir=$("${BASH:-bash}" "$sdd/sdd-workspace" "$plan")
log="$dir/task-${n}-tests.log"
native_plan=false
if [ -d "$plan" ]; then
  native_plan=true
  case "$n" in ''|0*|*[!0-9]*) printf 'task-done: expected a positive task number\n' >&2; exit 2 ;; esac
  if [ "$#" -ne 5 ] || [ "$1" != mulix ] || [ "$2" != test ] ||
    [ "$3" != receipt ] || [ "$4" != --task ] || [ "$5" != "$n" ]; then
    printf 'task-done: native Task %s requires mulix test receipt --task %s\n' "$n" "$n" >&2
    exit 2
  fi
  if [ -L "$log" ] || { [ -e "$log" ] && [ ! -f "$log" ]; }; then
    printf 'task-done: refusing unsafe receipt log path %s\n' "$log" >&2
    exit 2
  fi
  # Check the receipt after refreshing the approved brief, not before a
  # potentially newer task definition is read.
  "${BASH:-bash}" "$sdd/task-brief" "$plan" "$n" >/dev/null
  set -- "$@" --plan-path "$plan" --id-only
fi

# Shell quoting keeps arguments (including newlines) on one readable line.
printf -v cmd '%q ' "$@"
cmd=${cmd% }

rc=0
"$@" > "$log" 2>&1 || rc=$?

tail -n 5 "$log"
if [ "$rc" -ne 0 ]; then
  echo "task-done: test command exited $rc; Task $n NOT recorded (full output: $log)" >&2
  exit "$rc"
fi

last=$(grep -v '^[[:space:]]*$' "$log" | tail -n 1) || last="(no output)"
line="- Task $n: complete"
if [ "$native_plan" = true ]; then
  receipt=$(< "$log")
  if ! [[ "$receipt" =~ ^[0-9a-f]{32}$ ]]; then
    printf 'task-done: Task %s returned no single valid receipt ID\n' "$n" >&2
    exit 2
  fi
  line="$line (receipt $receipt)"
else
  # Legacy briefs reflect checkbox edits from the caller's test command.
  "${BASH:-bash}" "$sdd/task-brief" "$plan" "$n" >/dev/null
fi
ledger=$("${BASH:-bash}" "$sdd/progress-init" "$plan")

# A longer delimiter keeps literal backticks in commands and results intact.
code_span() {
  local text=$1 fence='`'
  while [[ "$text" == *"$fence"* ]]; do fence="$fence"'`'; done
  printf '%s %s %s' "$fence" "$text" "$fence"
}

last_heading=$(grep -E '^#{2,3} ' "$ledger" | tail -n 1 | tr -d '\r') || last_heading=""
last_phase=$(grep '^## ' "$ledger" | tail -n 1 | tr -d '\r') || last_phase=""
{
  # Separate appended content even when a legacy ledger has no final LF.
  printf '\n\n'
  if [ "$last_phase" = "## Final review" ]; then
    printf '## Task progress (continued)\n\n'
    last_heading=""
  fi
  if [ "$last_heading" != "### Task $n" ]; then
    printf '### Task %s\n\n' "$n"
  fi
  printf '%s\n' "$line"
  printf '  - Commits: '; code_span "$(git rev-parse --short=7 "$base")..$(git rev-parse --short=7 HEAD)"; printf '\n'
  printf '  - Tests: '; code_span "$cmd"; printf '\n'
  printf '  - Result: '; code_span "$last"; printf '\n'
  printf '  - Evidence: [test log](task-%s-tests.log)\n' "$n"
} >> "$ledger"
echo "ledger: $line"
